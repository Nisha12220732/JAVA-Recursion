import java.util.*;
public class Main{
    static List<Integer> func(int[] arr, int i, int target,List<Integer> ls){
        if(i<0){
            return ls;
        }
        if(arr[i] == target){
             ls.add(i);
        }
        func(arr,i-1,target,ls);
        return ls;
        
        
    }
    public static void main(String[] args){
        List<Integer> ls = new ArrayList<>();
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        for(int i=0;i<n;i++){
            arr[i] = sc.nextInt();
        }
        int target = sc.nextInt();
        System.out.println(func(arr,n-1,target,ls));
    }
}
