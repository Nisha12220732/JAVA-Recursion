import java.util.*;
class Main {
    public static void func(int n,int k){
        if(k == 0)
        return;
        
        func(n,k-1);
        System.out.println(n*k);
        return;
    }
    public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);
    int n = sc.nextInt();
    int k = sc.nextInt();
    func(n,k);
    }
}
