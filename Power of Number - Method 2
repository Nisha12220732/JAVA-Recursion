package Recurrsiontopic;

import java.util.Scanner;

public class Power_of_Number_Method2 {
    public static int ans = 1;
    public static int power(int p , int q){
        if(q== 0){
            return 1;
        }
        if(q%2 == 0){
            ans = power(p,q/2) * power(p,q/2);
        }
        if(q%2 != 0){
            ans =  p * power(p,q/2)*power(p,q/2);
        }
        return ans;
    }


    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int num = sc.nextInt();
        int n = sc.nextInt();
        System.out.println(power(num , n));
    }
}
