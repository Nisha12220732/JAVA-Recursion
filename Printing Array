package Recurrsiontopic;

import java.util.Scanner;

public class Recursively_printing_Array {
    public static void print_Array(int[] arr ,int ind){
        if(ind >= arr.length){
            return;
        }
        System.out.print(arr[ind] + " ");
        print_Array(arr,ind  + 1);
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n= sc.nextInt();
        int[] arr = new int[n];
        for(int i =0; i<n;i++){
            arr[i] = sc.nextInt();
        }
        print_Array(arr,0 );
    }
}
