import java.util.*;
class Main {
    static void func(String s, int i){
        if(i <0){
            return;
        }
        System.out.print(s.charAt(i) + " ");
        func(s,i-1);
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine();
        func(s,s.length()-1);
    }
}
