package Recurrsiontopic;

import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

public class Printing_All_Subsequence {
    public static List<List<Integer>> func(int ind,int[] arr , List ls , List ans){
        if(ind >= arr.length){
            ans.add(new ArrayList<>(ls));
            return ans;
        }
        ls.add(arr[ind]);
        func(ind+1,arr,ls,ans);
        ls.remove(ls.size() - 1);
        func(ind+1,arr,ls,ans);
        return ans;
    }

    public static void main(String[] args) {
        List<List<Integer>> ans = new ArrayList<>();
        List<Integer> ls = new ArrayList<>();
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        for(int i=0;i<n;i++){
            arr[i] = sc.nextInt();
        }
        System.out.println(func(0,arr,ls,ans));
    }
}
