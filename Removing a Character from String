import java.util.*;
class Main {
    static void func(String s, int i,char c){
        if(i <0){
            return;
        }
        func(s,i-1,c);
        if(s.charAt(i) != c)
        System.out.print(s.charAt(i) + " ");
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine();
        char ch = sc.next().charAt(0);
        func(s,s.length()-1,ch);
    }
}
