import java.util.*;
class Main {
    static List<List<Integer>> func(int[] arr,int i,List<Integer> ls, List<List<Integer>> ans){
        if(i > arr.length-1){
            ans.add(new ArrayList<>(ls));
            return ans;
        }
        ls.add(arr[i]);
        func(arr,i+1,ls,ans);
        ls.remove(ls.size() -1);
        func(arr,i+1,ls,ans);
        return ans;
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        for(int i =0;i<n;i++){
            arr[i] = sc.nextInt();
        }
        List<Integer> ls = new ArrayList<>();
        List<List<Integer>> ans = new ArrayList<>();
        func(arr,0,ls,ans);
        for(List<Integer> l : ans){
            for(int i: l){
                System.out.print(i + " ");
            }
            System.out.println();
        }
        System.out.println(ans);
    }
}
