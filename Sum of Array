import java.util.*;
class Main {
	public static int func(int[] arr,int ind) {
		if(ind == arr.length) {
			return 0;
		}
// 		int sum = 0;
		return func(arr,ind+1) + arr[ind];
	}
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int[] arr = new int[n];
		for(int i =0; i<n; i++) {
			arr[i] = sc.nextInt();
		}
		System.out.println(func(arr,0));
	}
}
